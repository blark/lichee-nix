+// Validate converted output/input before native code dereferences guest memory.
+// Uses Box64's existing page protection tracking; concurrent unmap is not
+// serialized by this check, matching the surrounding converter limitations.
+static int startup_access32(uint32_t addr, size_t size, uint32_t prot)
+{
+    if(!addr || addr >= 0xc0000000U || size > 0xc0000000U - addr) return 0;
+    uintptr_t end = (uintptr_t)addr + size;
+    for(uintptr_t p = addr; p < end; p = (p & ~(uintptr_t)(box64_pagesize-1)) + box64_pagesize)
+        if((getProtection(p) & prot) != prot) return 0;
+    return 1;
+}
+
+static int startup_limits32(x64emu_t* emu, int set, int resource, uint32_t addr)
+{
+    uint32_t limits[2];
+    if(!startup_access32(addr, sizeof(limits), set?PROT_READ:PROT_WRITE)) {
+        errno = EFAULT;
+        return -1;
+    }
+    if(set) {
+        memcpy(limits, from_ptrv(addr), sizeof(limits));
+        return my32_setrlimit(emu, resource, limits);
+    }
+    int r = my32_getrlimit(emu, resource, limits);
+    if(!r) memcpy(from_ptrv(addr), limits, sizeof(limits));
+    return r;
+}
+
+// i386 syscall 142 takes five register arguments. Its timeval has two
+// signed 32-bit longs and its fd bitmaps are rounded to 32-bit words.
+static int startup_select32(int nfds, uint32_t r, uint32_t w, uint32_t e, uint32_t t)
+{
+    if(nfds < 0 || nfds > FD_SETSIZE) { errno = EINVAL; return -1; }
+    size_t bytes = ((nfds + 31) / 32) * 4;
+    uint32_t addresses[3] = {r, w, e};
+    fd_set sets[3];
+    memset(sets, 0, sizeof(sets));
+    for(int i=0; i<3; ++i) {
+        if(!addresses[i] || !bytes) continue;
+        if(!startup_access32(addresses[i], bytes, PROT_READ|PROT_WRITE)) {
+            errno = EFAULT;
+            return -1;
+        }
+        memcpy(&sets[i], from_ptrv(addresses[i]), bytes);
+    }
+    struct timeval timeout;
+    int32_t guest_time[2];
+    if(t) {
+        if(!startup_access32(t, sizeof(guest_time), PROT_READ|PROT_WRITE)) {
+            errno = EFAULT;
+            return -1;
+        }
+        memcpy(guest_time, from_ptrv(t), sizeof(guest_time));
+        timeout.tv_sec = guest_time[0];
+        timeout.tv_usec = guest_time[1];
+    }
+    int result = select(nfds, r?&sets[0]:NULL, w?&sets[1]:NULL,
+                        e?&sets[2]:NULL, t?&timeout:NULL);
+    int saved_errno = errno;
+    if(result >= 0 && bytes)
+        for(int i=0; i<3; ++i)
+            if(addresses[i]) memcpy(from_ptrv(addresses[i]), &sets[i], bytes);
+    if(t) {
+        guest_time[0] = timeout.tv_sec;
+        guest_time[1] = timeout.tv_usec;
+        memcpy(from_ptrv(t), guest_time, sizeof(guest_time));
+    }
+    errno = saved_errno;
+    return result;
+}
+
+static int64_t startup_time32(uint32_t addr)
+{
+    if(addr && !startup_access32(addr, 4, PROT_WRITE)) { errno = EFAULT; return -1; }
+    time_t now = time(NULL);
+    if(now == (time_t)-1) return -1;
+    if(addr) {
+        int32_t value = (int32_t)now;
+        memcpy(from_ptrv(addr), &value, sizeof(value));
+    }
+    return (uint32_t)now;
+}
