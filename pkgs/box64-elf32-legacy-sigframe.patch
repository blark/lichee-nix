+int32_t my32_raw_sigsuspend(x64emu_t* emu, uint32_t set, int size)
+{
+    if(size!=8) { errno=EINVAL; return -EINVAL; }
+    if(!raw_memory32(set,8,PROT_READ)) { errno=EFAULT; return -EFAULT; }
+    uint64_t guest, native, current=0;
+    memcpy(&guest,from_ptrv(set),8);
+    if(syscall(__NR_rt_sigprocmask,SIG_SETMASK,NULL,&current,8)) return -errno;
+    native=raw_native_mask32(guest) | (current & (UINT64_C(3)<<31));
+    unsigned serial=emu->raw_signal_serial32;
+    R_EAX=(uint32_t)-EINTR;
+    int r=syscall(__NR_rt_sigsuspend,&native,8);
