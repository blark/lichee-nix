+int my32_raw_sigaction(x64emu_t* emu, int sig, uint32_t act, uint32_t old, int size)
+{
+    (void)emu;
+    if(size!=8 || sig<1 || sig>62 || sig==SIGKILL || sig==SIGSTOP) { errno=EINVAL; return -1; }
+    if((act && !raw_memory32(act,20,PROT_READ)) || (old && !raw_memory32(old,20,PROT_WRITE))) {
+        errno=EFAULT; return -1;
+    }
+    kernel_action32_t action, previous;
+    if(act) {
+        memcpy(&action,from_ptrv(act),sizeof(action));
+        uint64_t mask=(uint64_t)action.mask[0] | ((uint64_t)action.mask[1]<<32);
+        if((action.flags&SA_SIGINFO) && action.handler>1) { errno=ENOTSUP; return -1; }
+        struct sigaction native={0};
+        uint64_t mapped=raw_native_mask32(mask);
+        memcpy(&native.sa_mask,&mapped,8);
+        native.sa_flags=(action.flags&~0x04000000U) | (action.handler>1?SA_SIGINFO:0);
+        native.sa_sigaction=action.handler>1?raw_handler32:(void*)(uintptr_t)action.handler;
+        uint64_t saved=raw_lock_actions32();
+        memcpy(&previous,my_context->raw_sigaction32[sig],sizeof(previous));
+        int r=sigaction(raw_native_signal32(sig),&native,NULL);
+        int saved_errno=errno;
+        if(!r) memcpy(my_context->raw_sigaction32[sig],&action,sizeof(action));
+        raw_unlock_actions32(saved);
+        errno=saved_errno;
+        if(r) return r;
+    }
+    if(!act) {
+        uint64_t saved=raw_lock_actions32();
+        memcpy(&previous,my_context->raw_sigaction32[sig],sizeof(previous));
+        raw_unlock_actions32(saved);
+    }
+    if(old) memcpy(from_ptrv(old),&previous,sizeof(previous));
+    return 0;
+}
