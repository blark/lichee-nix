+int my32_raw_sigprocmask(x64emu_t* emu, int how, uint32_t set, uint32_t old, int size)
+{
+    (void)emu;
+    if(size!=8) { errno=EINVAL; return -1; }
+    if((set && !raw_memory32(set,8,PROT_READ)) || (old && !raw_memory32(old,8,PROT_WRITE))) {
+        errno=EFAULT; return -1;
+    }
+    uint64_t guest=0, native=0, previous=0, current=0;
+    if(set) {
+        memcpy(&guest, from_ptrv(set), 8);
+        // Unsupported guest63/64 mask bits are ignored, like mask bits beyond
+        // the implemented signal set. sigfillset must still be usable.
+        native=raw_native_mask32(guest);
+        if(how==SIG_SETMASK) {
+            if(syscall(__NR_rt_sigprocmask, SIG_SETMASK, NULL, &current, 8)) return -1;
+            native|=current & (UINT64_C(3)<<31);
+        }
+    }
+    int r=syscall(__NR_rt_sigprocmask, how, set?&native:NULL, old?&previous:NULL, 8);
+    if(!r && old) { guest=raw_guest_mask32(previous); memcpy(from_ptrv(old),&guest,8); }
+    return r;
