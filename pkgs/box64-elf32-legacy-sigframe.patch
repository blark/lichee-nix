+    void* previous_run=emu->raw_signal_run32;
+    int previous_quit=emu->quit;
+    int previous_need=emu->flags.need_jmpbuf;
+    emu->raw_signal_run32=&run;
+    emu->quit=0;
+    emu->flags.need_jmpbuf=1;
+    R_ESP=addr; R_EIP=action.handler;
+    RESET_FLAGS(emu);
+    CLEAR_FLAG(F_TF); CLEAR_FLAG(F_DF);
+    printf_log(LOG_DEBUG,"Raw signal32 %d: handler=%p frame=%p interrupted=%p fault=%p eax=%x ebx=%x ecx=%x edx=%x esp=%x ebp=%x\n",
+        sig,from_ptrv(R_EIP),f,from_ptrv(f->cpustate.gregs[I386_EIP]),info->si_addr,
+        f->cpustate.gregs[I386_EAX],f->cpustate.gregs[I386_EBX],
+        f->cpustate.gregs[I386_ECX],f->cpustate.gregs[I386_EDX],
+        f->cpustate.gregs[I386_ESP],f->cpustate.gregs[I386_EBP]);
+    // Enter the kernel frame directly. No EmuCall/DynaCall exit-address push
+    // and no saved-register epilogue that could undo a guest sigcontext edit.
+    EmuRun(emu,0,0);
+    emu->raw_signal_run32=previous_run;
+    emu->flags.need_jmpbuf=previous_need;
