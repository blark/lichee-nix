+uint32_t my32_sigreturn(x64emu_t* emu)
+{
+    raw_signal_run32_t* run=emu->raw_signal_run32;
+    uint32_t addr=R_ESP-8;
+    if(!run || addr!=run->frame || !raw_memory32(addr,sizeof(i386_sigframe_t),PROT_READ))
+        goto bad_frame;
+    i386_sigframe_t frame;
+    memcpy(&frame,from_ptrv(addr),sizeof(frame));
+    i386_mcontext_t* m=&frame.cpustate;
+    if((m->gregs[I386_CS]&3)!=3 || (m->gregs[I386_SS]&3)!=3) goto bad_frame;
+    struct i386_fpstate fp;
+    if(m->fpregs) {
+        if(!raw_memory32(m->fpregs,sizeof(fp),PROT_READ)) goto bad_frame;
+        memcpy(&fp,from_ptrv(m->fpregs),sizeof(fp));
+        raw_load_fp32(emu,&fp);
+    }
+    #define GO(R) R_##R=m->gregs[I386_##R]
+    GO(EAX); GO(ECX); GO(EDX); GO(EBX); GO(ESI); GO(EDI); GO(EBP); GO(ESP); GO(EIP);
+    GO(CS); GO(SS); GO(DS); GO(ES); GO(FS); GO(GS);
+    #undef GO
+    for(int seg=0;seg<6;++seg) {
+        emu->segs_offs[seg]=0;
+        GetSegmentBaseEmu(emu,seg);
