+static int ordinary_stat32(int call, uint32_t path_or_fd, uint32_t output)
+{
+    struct stat64 st;
+    // Fetch to native storage first: never copy uninitialized data on failure.
+    int r = call==197 ? fstat64((int)path_or_fd, &st)
+                      : stat64(from_ptrv(path_or_fd), &st);
+    if(r) return r;
+    size_t size = call==106 ? sizeof(kernel_stat32_t) : sizeof(struct i386_stat64);
+    if(!startup_access32(output, size, PROT_WRITE)) { errno=EFAULT; return -1; }
+    if(call==106) {
+        if(st.st_ino>UINT32_MAX || st.st_nlink>UINT16_MAX || st.st_size>INT32_MAX ||
+           st.st_size<0 || st.st_blocks>UINT32_MAX || major(st.st_dev)>4095 ||
+           major(st.st_rdev)>4095 || minor(st.st_dev)>1048575 || minor(st.st_rdev)>1048575) {
+            errno=EOVERFLOW; return -1;
+        }
+        kernel_stat32_t guest = {
+            .dev=kernel_device32(st.st_dev), .ino=st.st_ino,
+            .mode=st.st_mode, .nlink=st.st_nlink,
+            .uid=st.st_uid>65535?65534:st.st_uid,
+            .gid=st.st_gid>65535?65534:st.st_gid,
+            .rdev=kernel_device32(st.st_rdev), .size=st.st_size,
+            .blksize=st.st_blksize, .blocks=st.st_blocks,
+            .atime=st.st_atim.tv_sec, .atime_nsec=st.st_atim.tv_nsec,
+            .mtime=st.st_mtim.tv_sec, .mtime_nsec=st.st_mtim.tv_nsec,
+            .ctime=st.st_ctim.tv_sec, .ctime_nsec=st.st_ctim.tv_nsec,
+        };
+        memcpy(from_ptrv(output), &guest, sizeof(guest));
+    } else {
+        struct i386_stat64 guest = {0};
+        UnalignStat64_32(&st, &guest);
+        guest.st_dev=kernel_device32(st.st_dev);
+        guest.st_rdev=kernel_device32(st.st_rdev);
+        memcpy(from_ptrv(output), &guest, sizeof(guest));
+    }
+    return 0;
+}
