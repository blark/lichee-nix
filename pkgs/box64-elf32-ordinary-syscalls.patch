+static int ordinary_gettimeofday32(uint32_t tv, uint32_t tz)
+{
+    if((tv && !startup_access32(tv, 8, PROT_WRITE)) ||
+       (tz && !startup_access32(tz, 8, PROT_WRITE))) { errno=EFAULT; return -1; }
+    struct timeval now;
+    struct timezone zone;
+    int r=gettimeofday(tv?&now:NULL, tz?&zone:NULL);
+    if(r) return r;
+    if(tv) {
+        int32_t guest[2]={now.tv_sec, now.tv_usec};
+        memcpy(from_ptrv(tv), guest, sizeof(guest));
+    }
+    if(tz) memcpy(from_ptrv(tz), &zone, 8);
+    return 0;
+}
