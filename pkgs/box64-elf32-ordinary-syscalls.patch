+typedef struct shm_attach32_s {
+    void* addr;
+    size_t size;
+    struct shm_attach32_s* next;
+} shm_attach32_t;
+static shm_attach32_t* shm_attachments32;
+static pthread_mutex_t shm_attach_mutex32=PTHREAD_MUTEX_INITIALIZER;
+static int ordinary_ipc_impl32(x64emu_t* emu, uint32_t call, int first, uint32_t second, uint32_t third, uint32_t ptr)
+{
+    // i386 SysV IPC multiplexes its operation in the low 16 bits. SHMAT v0
+    // writes the resulting 32-bit address through its third argument.
+    if(call>>16) { errno=ENOSYS; return -1; }
+    switch(call) {
+        case 23: return shmget(first,second,third);
+        case 21: {
+            if(!startup_access32(third,4,PROT_WRITE)) { errno=EFAULT; return -1; }
+            void* addr=my32_shmat(emu,first,from_ptrv(ptr),second);
+            if(addr==(void*)-1) return -1;
+            if((uintptr_t)addr>=0xc0000000U) { shmdt(addr); errno=ENOMEM; return -1; }
+            struct shmid_ds ds;
+            if(shmctl(first,IPC_STAT,&ds)) { int error=errno; shmdt(addr); errno=error; return -1; }
+            shm_attach32_t* attachment=box_malloc(sizeof(*attachment));
+            if(!attachment) { shmdt(addr); errno=ENOMEM; return -1; }
+            attachment->addr=addr; attachment->size=ds.shm_segsz;
+            pthread_mutex_lock(&shm_attach_mutex32);
+            attachment->next=shm_attachments32; shm_attachments32=attachment;
+            setProtection_mmap((uintptr_t)addr,ds.shm_segsz,
+                second&SHM_RDONLY?PROT_READ:PROT_READ|PROT_WRITE);
+            pthread_mutex_unlock(&shm_attach_mutex32);
+            uint32_t guest=to_ptrv(addr);
+            memcpy(from_ptrv(third),&guest,4);
+            return 0;
+        }
+        case 22: {
+            pthread_mutex_lock(&shm_attach_mutex32);
+            int r=shmdt(from_ptrv(ptr));
+            int saved=errno;
+            if(!r) {
+                shm_attach32_t** entry=&shm_attachments32;
+                while(*entry && (*entry)->addr!=from_ptrv(ptr)) entry=&(*entry)->next;
+                if(*entry) {
+                    shm_attach32_t* old=*entry; *entry=old->next;
+                    freeProtection((uintptr_t)old->addr,old->size);
+                    box_free(old);
+                }
+            }
+            pthread_mutex_unlock(&shm_attach_mutex32);
+            errno=saved;
+            return r;
+        }
+        case 24:
+            // IPC_RMID has no structure to convert; other shmctl forms do.
+            if(second==IPC_RMID) return shmctl(first,IPC_RMID,NULL);
+            errno=ENOSYS; return -1;
+    }
+    errno=ENOSYS; return -1;
+}
+// The attachment mutex cannot be taken from an interrupt of its owner. Keep
+// native signals blocked only around this small, non-guest-code operation.
+static int ordinary_ipc32(x64emu_t* emu, uint32_t call, int first, uint32_t second, uint32_t third, uint32_t ptr)
+{
+    uint64_t all=UINT64_MAX, saved;
+    if(syscall(__NR_rt_sigprocmask,SIG_BLOCK,&all,&saved,8)) return -1;
+    int r=ordinary_ipc_impl32(emu,call,first,second,third,ptr);
+    int error=errno;
+    syscall(__NR_rt_sigprocmask,SIG_SETMASK,&saved,NULL,8);
+    errno=error;
+    return r;
+}
+int my32_ioctl(x64emu_t* emu, int fd, unsigned long op, void* arg);
+// Shared by raw int-0x80 and wrapped syscall(). Result is libc-style here;
+// only the raw caller converts -1/errno into a negative i386 errno.
+static int ordinary_syscall32(x64emu_t* emu, int call, uint32_t a, uint32_t b,
+                              uint32_t c, uint32_t d, uint32_t e, int32_t* result)
+{
+    switch(call) {
+        case 24: { uid_t id=getuid(); *result=id>65535?65534:id; break; }
+        case 47: { gid_t id=getgid(); *result=id>65535?65534:id; break; }
+        case 49: { uid_t id=geteuid(); *result=id>65535?65534:id; break; }
+        case 50: { gid_t id=getegid(); *result=id>65535?65534:id; break; }
+        case 9: *result=link(from_ptrv(a),from_ptrv(b)); break;
+        case 10: *result=unlink(from_ptrv(a)); break;
+        case 38: *result=rename(from_ptrv(a),from_ptrv(b)); break;
+        case 102: *result=ordinary_socketcall32(a,b); break;
+        case 117: *result=ordinary_ipc32(emu,a,b,c,d,e); break;
+        case 125: *result=my32_mprotect(emu,from_ptrv(a),b,c); break;
+        case 146: {
+            if(c>1024 || (c && !startup_access32(b,c*8,PROT_READ))) {
+                errno=c>1024?EINVAL:EFAULT; *result=-1; break;
+            }
+            struct iovec native[c?c:1];
+            for(uint32_t i=0;i<c;++i) {
+                uint32_t entry[2]; memcpy(entry,from_ptrv(b+i*8),8);
+                native[i].iov_base=from_ptrv(entry[0]); native[i].iov_len=entry[1];
+            }
+            *result=writev(a,native,c); break;
+        }
+        case 162: *result=ordinary_nanosleep32(a,b); break;
+        case 163: *result=to_ptrv(my32_mremap(emu,from_ptrv(a),b,c,d,from_ptrv(e))); break;
+        case 19: { // signed 32-bit off_t
+            off_t r=lseek((int)a, (int32_t)b, (int)c);
+            if(r>INT32_MAX) { errno=EOVERFLOW; r=-1; }
+            *result=r; break;
+        }
+        case 33: *result=access(from_ptrv(a), b); break;
+        case 39: *result=mkdir(from_ptrv(a), b); break;
+        case 40: *result=rmdir(from_ptrv(a)); break;
+        case 41: *result=dup((int)a); break;
+        case 54: *result=my32_ioctl(emu, (int)a, b, from_ptrv(c)); break;
+        case 55:
+        case 221: *result=ordinary_fcntl32((int)a, b, c); break;
+        case 78: *result=ordinary_gettimeofday32(a, b); break;
+        case 85: *result=readlink(from_ptrv(a), from_ptrv(b), c); break;
+        case 106:
+        case 195:
+        case 197: *result=ordinary_stat32(call, a, b); break;
+        case 140: { // high/low offset, result pointer, whence
+            int64_t offset=(int64_t)(((uint64_t)b<<32)|c);
+            off_t r=lseek((int)a, offset, (int)e);
+            *result=r==-1?-1:0;
+            if(r!=-1) {
+                if(!startup_access32(d, 8, PROT_WRITE)) { errno=EFAULT; *result=-1; break; }
+                memcpy(from_ptrv(d), &r, 8);
+            }
+            break;
+        }
+        case 168: // pollfd has identical fixed-width fields (8 bytes)
+            *result=poll(from_ptrv(a), b, (int)c); break;
+        default: return 0;
+    }
+    return 1;
+}
