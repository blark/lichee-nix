+// Kernel stat(106) is not libc's version-3 stat structure (64 vs 88 bytes).
+typedef struct kernel_stat32_s {
+    uint32_t dev, ino;
+    uint16_t mode, nlink, uid, gid;
+    uint32_t rdev, size, blksize, blocks;
+    uint32_t atime, atime_nsec, mtime, mtime_nsec, ctime, ctime_nsec;
+    uint32_t unused[2];
+} kernel_stat32_t;
+_Static_assert(sizeof(kernel_stat32_t)==64, "i386 kernel stat size");
+_Static_assert(sizeof(struct i386_stat64)==96, "i386 kernel stat64 size");
