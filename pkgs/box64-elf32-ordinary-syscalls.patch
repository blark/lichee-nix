+// Use the existing flag converters, but do not depend on wrapped libc having
+// been initialized. In particular my32_fcntl64 returns a fake 0 without my_lib.
+static int ordinary_fcntl32(int fd, int cmd, uint32_t arg)
+{
+    if(cmd==5 || cmd==6 || cmd==7 || cmd==12 || cmd==13 || cmd==14) {
+        int wide=cmd>=12;
+        size_t size=wide?sizeof(x86_flock64_t):sizeof(i386_flock_t);
+        if(!startup_access32(arg, size, PROT_READ | ((cmd==5 || cmd==12)?PROT_WRITE:0))) {
+            errno=EFAULT; return -1;
+        }
+        struct flock native = {0};
+        if(wide) AlignFlock64_32(&native, from_ptrv(arg));
+        else AlignFlock_32(&native, from_ptrv(arg));
+        int r=fcntl(fd, wide?cmd-7:cmd, &native);
+        if(!r && (cmd==5 || cmd==12)) {
+            if(!wide && (native.l_start>INT32_MAX || native.l_start<INT32_MIN ||
+                         native.l_len>INT32_MAX || native.l_len<INT32_MIN)) {
+                errno=EOVERFLOW; return -1;
+            }
+            if(wide) UnalignFlock64_32(from_ptrv(arg), &native);
+            else UnalignFlock_32(from_ptrv(arg), &native);
+        }
+        return r;
+    }
+    int r=fcntl(fd, cmd, cmd==F_SETFL?of_convert32(arg):arg);
+    return cmd==F_GETFL && r!=-1 ? of_unconvert32(r) : r;
+}
