+static int ordinary_nanosleep32(uint32_t req, uint32_t rem)
+{
+    if(!startup_access32(req,8,PROT_READ) || (rem && !startup_access32(rem,8,PROT_WRITE))) {
+        errno=EFAULT; return -1;
+    }
+    int32_t guest[2];
+    memcpy(guest,from_ptrv(req),8);
+    struct timespec native={guest[0],guest[1]}, left;
+    int r=nanosleep(&native, rem?&left:NULL);
+    if(r==-1 && errno==EINTR && rem) {
+        guest[0]=left.tv_sec; guest[1]=left.tv_nsec;
+        memcpy(from_ptrv(rem),guest,8);
+    }
+    return r;
+}
+static int ordinary_socketcall32(unsigned call, uint32_t args)
+{
+    static const uint8_t counts[]={0,3,3,3,2,3,3,3,4,4,4,6,6,2,5,5};
+    if(!call || call>=sizeof(counts)) { errno=ENOSYS; return -1; }
+    if(!startup_access32(args,counts[call]*4,PROT_READ)) { errno=EFAULT; return -1; }
+    uint32_t v[6]={0}; memcpy(v,from_ptrv(args),counts[call]*4);
+    switch(call) {
+        case 1: return socket(v[0],v[1],v[2]);
+        case 2: return bind(v[0],from_ptrv(v[1]),v[2]);
+        case 3: return connect(v[0],from_ptrv(v[1]),v[2]);
+        case 4: return listen(v[0],v[1]);
+        case 5: return accept(v[0],from_ptrv(v[1]),from_ptrv(v[2]));
+        case 6: return getsockname(v[0],from_ptrv(v[1]),from_ptrv(v[2]));
+        case 7: return getpeername(v[0],from_ptrv(v[1]),from_ptrv(v[2]));
+        case 8: return socketpair(v[0],v[1],v[2],from_ptrv(v[3]));
+        case 9: return send(v[0],from_ptrv(v[1]),v[2],v[3]);
+        case 10: return recv(v[0],from_ptrv(v[1]),v[2],v[3]);
+        case 11: return sendto(v[0],from_ptrv(v[1]),v[2],v[3],from_ptrv(v[4]),v[5]);
+        case 12: return recvfrom(v[0],from_ptrv(v[1]),v[2],v[3],from_ptrv(v[4]),from_ptrv(v[5]));
+        case 13: return shutdown(v[0],v[1]);
+        case 14: return setsockopt(v[0],v[1],v[2],from_ptrv(v[3]),v[4]);
+        case 15: return getsockopt(v[0],v[1],v[2],from_ptrv(v[3]),from_ptrv(v[4]));
+    }
+    errno=ENOSYS; return -1;
+}
