+// Linux's raw brk returns the current break on failure, not -errno.
+// Use guest mappings, never the native libc's process break.
+static uint32_t guest_brk32(x64emu_t* emu, uint32_t requested)
+{
+    box64context_t* ctx = emu->context;
+    // Box64 releases mutex_thread around guest signal handlers. Defer async
+    // signals here so no nested brk can observe a half-completed mapping change.
+    sigset_t block, saved;
+    sigfillset(&block);
+    sigdelset(&block, SIGSEGV);
+    sigdelset(&block, SIGBUS);
+    sigdelset(&block, SIGILL);
+    sigdelset(&block, SIGFPE);
+    sigdelset(&block, SIGTRAP);
+    if(pthread_sigmask(SIG_BLOCK, &block, &saved))
+        return ctx->brk32_current;
+    mutex_lock(&ctx->mutex_thread);
+    uintptr_t current = ctx->brk32_current;
+    uintptr_t page = box64_pagesize;
+    if(!ctx->brk32_start || requested < ctx->brk32_start || requested >= 0xc0000000U)
+        goto done;
+    struct rlimit limit;
+    if(getrlimit(RLIMIT_DATA, &limit) == 0 && limit.rlim_cur != RLIM_INFINITY
+       && (ctx->brk32_data > limit.rlim_cur
+           || requested - ctx->brk32_start > limit.rlim_cur - ctx->brk32_data))
+        goto done;
+    uintptr_t next = ((uintptr_t)requested + page - 1) & ~(page - 1);
+    if(next > ctx->brk32_mapped) {
+        size_t size = next - ctx->brk32_mapped;
+        // MAP_FIXED_NOREPLACE is atomic: never overwrite a library or guest mmap.
+        void* addr = (void*)ctx->brk32_mapped;
+        void* mapped = my32_mmap64(emu, addr, size, PROT_READ|PROT_WRITE,
+            MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE, -1, 0);
+        if(mapped == MAP_FAILED)
+            goto done;
+        if(mapped != addr) {
+            my32_munmap(emu, mapped, size);
+            goto done;
+        }
+    } else if(next < ctx->brk32_mapped) {
+        if(my32_munmap(emu, (void*)next, ctx->brk32_mapped - next))
+            goto done;
+    }
+    ctx->brk32_mapped = next;
+    ctx->brk32_current = current = requested;
+done:
+    mutex_unlock(&ctx->mutex_thread);
+    pthread_sigmask(SIG_SETMASK, &saved, NULL);
+    return current;
+}
